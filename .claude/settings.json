{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/check_docs.py\" --hook",
            "timeout": 30,
            "statusMessage": "Checking the docs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/lint-on-edit.js\"",
            "timeout": 30,
            "statusMessage": "Linting the file"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "PowerShell(python scripts/*)",
      "Bash(python -m ruff *)",
      "PowerShell(python -m ruff *)",
      "Bash(node scripts/*)",
      "PowerShell(node scripts/*)",
      "Bash(node tests/*)",
      "PowerShell(node tests/*)",
      "Bash(npx eslint *)",
      "PowerShell(npx eslint *)",
      "Bash(git status*)",
      "PowerShell(git status*)",
      "Bash(git diff*)",
      "PowerShell(git diff*)",
      "Bash(git log*)",
      "PowerShell(git log*)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git branch*)",
      "PowerShell(git branch*)",
      "Bash(git checkout *)",
      "PowerShell(git checkout *)",
      "Bash(git restore *)",
      "PowerShell(git restore *)",
      "Bash(git stash*)",
      "PowerShell(git stash*)",
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(git rev-parse *)",
      "PowerShell(git rev-parse *)",
      "Bash(gh pr *)",
      "PowerShell(gh pr *)",
      "Bash(gh run *)",
      "PowerShell(gh run *)",
      "Bash(gh workflow *)",
      "PowerShell(gh workflow *)",
      "Bash(supabase db query *)",
      "PowerShell(supabase db query *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Select-String *)",
      "PowerShell(Where-Object *)",
      "PowerShell(ForEach-Object *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Sort-Object *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Split-Path *)",
      "PowerShell(Join-Path *)",
      "PowerShell(ConvertFrom-Json*)",
      "PowerShell(ConvertTo-Json *)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(git switch *)",
      "PowerShell(git switch *)",
      "Bash(git pull*)",
      "PowerShell(git pull*)",
      "Bash(git fetch*)",
      "PowerShell(git fetch*)",
      "Bash(graphify *)",
      "PowerShell(graphify *)",
      "Bash(python C:/Users/CRUIZ/AppData/Local/Temp/claude/*)",
      "PowerShell(python C:/Users/CRUIZ/AppData/Local/Temp/claude/*)",
      "Bash(python C:\\Users\\CRUIZ\\AppData\\Local\\Temp\\claude\\*)",
      "PowerShell(python C:\\Users\\CRUIZ\\AppData\\Local\\Temp\\claude\\*)"
    ]
  }
}
